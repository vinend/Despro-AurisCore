# Local Python runtime containing AI-Pipeline/requirements-cnn.txt dependencies.
# Use absolute paths; restart Next.js after changing these settings.
AURISCORE_PYTHON="C:/path/to/python.exe"
AURISCORE_PIPELINE_DIR="C:/path/to/Despro-AurisCore/AI-Pipeline"
# Leave unset until an explicitly selected final package has been prepared.
# AURISCORE_HEART_PACKAGE="C:/path/to/heart-deployment"
# AURISCORE_ABDOMEN_PACKAGE="C:/path/to/abdomen-deployment"

# Server-only account assignment for this deployment's single device/namespace.
# Comma-separated verified account emails; never a NEXT_PUBLIC variable.
# AURISCORE_DEVICE_ACCOUNT_EMAILS="owner@example.com"
# Optional cross-device account and private session storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
