        "augmentation_snr_db_min": 25.0,
        "augmentation_snr_db_max": 35.0,
        "augmentation_frequency_mask_bins": 2,
        "augmentation_frequency_mask_count": 1,
        "augmentation_time_mask_frames": 8,
        "augmentation_time_mask_count": 1
      }
    },
    {"name": "cnn-learning-rate-0003", "overrides": {"cnn_learning_rate": 0.0003}},
    {"name": "cnn-residual-se", "overrides": {"cnn_architecture": "residual_se"}},
    {
      "name": "cnn-per-frequency-normalization",
      "overrides": {"spectrogram_normalization": "per_frequency", "spectrogram_normalization_clip": 5.0}
    },
    {"name": "cnn-logmel-96", "overrides": {"n_mels": 96}}
  ]
