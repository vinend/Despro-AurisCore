# Copy to ignored hosting/hosting.env. No real defaults or secrets are included.
AURISCORE_DOMAIN=REPLACE_WITH_YOUR_DOMAIN
AURISCORE_MODELS_DIR=/opt/auriscore-private/models
AURISCORE_DEVICE_TOKEN=REPLACE_WITH_NEW_RANDOM_PAIRING_TOKEN
AURISCORE_WEB_USER=REPLACE_WITH_USERNAME
# Single quotes preserve the dollar signs in a bcrypt hash.
AURISCORE_WEB_PASSWORD_HASH='REPLACE_WITH_CADDY_BCRYPT_HASH'
